# Maintainer: Huzzama <chewbaccanator0405@gmail.com>
pkgname=neru-screen-control
pkgver=2.1.1
pkgrel=1
pkgdesc="Cooler LCD screens (Thermaltake, Thermalright), PC RGB lighting via OpenRGB and fan curves — one app"
arch=('x86_64')
url="https://github.com/Huzzama/Neru-screen-control"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'libusb' 'polkit')
optdepends=(
  'openrgb: RGB lighting control'
  'ffmpeg: video backgrounds on the screen'
)
makedepends=('cargo' 'rust' 'nodejs' 'npm' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir="Neru-screen-control-$pkgver"

prepare() {
  cd "$srcdir/$_srcdir"
  npm install --no-audit --no-fund
}

build() {
  cd "$srcdir/$_srcdir"
  npm --prefix ui run build
  cargo build --release --locked -p neru-screen-control -p neru-cli -p neru-fand
}

check() {
  cd "$srcdir/$_srcdir"
  cargo test --release --locked -p neru-core
}

package() {
  cd "$srcdir/$_srcdir"
  install -Dm755 target/release/neru-screen-control "$pkgdir/usr/bin/neru-screen-control"
  install -Dm755 target/release/neru              "$pkgdir/usr/bin/neru"
  install -Dm755 target/release/neru-fand         "$pkgdir/usr/bin/neru-fand"

  # Bundled fonts and themes (found via /usr/share/neru-screen-control/assets)
  install -dm755 "$pkgdir/usr/share/$pkgname/assets"
  cp -r assets/fonts assets/themes "$pkgdir/usr/share/$pkgname/assets/"

  install -Dm644 packaging/shared/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  for size in 32 128 256 512; do
    case $size in
      32)  src=src-tauri/icons/32x32.png ;;
      128) src=src-tauri/icons/128x128.png ;;
      256) src=src-tauri/icons/128x128@2x.png ;;
      512) src=src-tauri/icons/icon.png ;;
    esac
    install -Dm644 "$src" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done

  install -Dm644 packaging/shared/70-neru-screen-control.rules "$pkgdir/usr/lib/udev/rules.d/70-neru-screen-control.rules"
  install -Dm644 packaging/shared/neru-screen-control-modules.conf "$pkgdir/usr/lib/modules-load.d/neru-screen-control.conf"
  # Fan helper unit — stays disabled until enabled from the app (Fans → Install helper)
  install -Dm644 packaging/shared/neru-fand.service "$pkgdir/usr/lib/systemd/system/neru-fand.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
