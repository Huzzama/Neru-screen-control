#!/bin/sh
# Neru Screen Control — after install: activate the udev rule and tell systemd
# about the fan helper unit (it stays disabled until enabled from the app).
set -e
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger || true
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi
# GPU / DRAM RGB controllers are reached over I2C.
modprobe i2c-dev 2>/dev/null || true; modprobe i2c-piix4 2>/dev/null || true; modprobe i2c-i801 2>/dev/null || true
exit 0
