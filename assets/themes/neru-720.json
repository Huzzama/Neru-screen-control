{
  "name": "Neru 720",
  "version": 1,
  "width": 720,
  "height": 720,
  "background": { "kind": "gradient", "from": "#0b0b14", "to": "#1a1230", "angle": 160 },
  "smoothing": 0.5,
  "elements": [
    { "id": "clock", "type": "text", "x": 360, "y": 118, "text": "{time:%H:%M}", "font": "Bebas Neue", "size": 120, "weight": 400, "color": "#ffffff", "align": "center", "letter_spacing": 4 },
    { "id": "date", "type": "text", "x": 360, "y": 152, "text": "{date:%A %d %B}", "font": "Inter", "size": 22, "weight": 500, "color": "#8b8aa8", "align": "center", "letter_spacing": 2 },

    { "id": "cpu-gauge", "type": "gauge", "x": 196, "y": 340, "r": 128, "thickness": 22, "metric": "cpu.temp", "min": 20, "max": 95, "start": -135, "sweep": 270, "color": "#ffc20e", "track": "#1f1d33", "round_caps": true,
      "ramp": [ { "at": 35, "color": "#3dd6ff" }, { "at": 65, "color": "#ffc20e" }, { "at": 90, "color": "#ff3b5c" } ] },
    { "id": "cpu-label", "type": "text", "x": 196, "y": 292, "text": "CPU", "font": "Inter", "size": 22, "weight": 700, "color": "#8b8aa8", "align": "center", "letter_spacing": 4 },
    { "id": "cpu-temp", "type": "text", "x": 204, "y": 372, "text": "{cpu.temp:0}°", "font": "Rajdhani", "size": 96, "weight": 700, "color": "#ffffff", "align": "center" },
    { "id": "cpu-sub", "type": "text", "x": 196, "y": 408, "text": "{cpu.usage:0}%  ·  {cpu.freq:0} MHz", "font": "JetBrains Mono", "size": 17, "weight": 400, "color": "#8b8aa8", "align": "center" },
    { "id": "cpu-watts", "type": "text", "x": 196, "y": 466, "text": "{cpu.power:0} W", "font": "JetBrains Mono", "size": 18, "weight": 700, "color": "#ffc20e", "align": "center" },

    { "id": "gpu-gauge", "type": "gauge", "x": 524, "y": 340, "r": 128, "thickness": 22, "metric": "gpu.temp", "min": 20, "max": 95, "start": -135, "sweep": 270, "color": "#9b30ff", "track": "#1f1d33", "round_caps": true,
      "ramp": [ { "at": 35, "color": "#3dd6ff" }, { "at": 65, "color": "#9b30ff" }, { "at": 90, "color": "#ff3b5c" } ] },
    { "id": "gpu-label", "type": "text", "x": 524, "y": 292, "text": "GPU", "font": "Inter", "size": 22, "weight": 700, "color": "#8b8aa8", "align": "center", "letter_spacing": 4 },
    { "id": "gpu-temp", "type": "text", "x": 532, "y": 372, "text": "{gpu.temp:0}°", "font": "Rajdhani", "size": 96, "weight": 700, "color": "#ffffff", "align": "center" },
    { "id": "gpu-sub", "type": "text", "x": 524, "y": 408, "text": "{gpu.usage:0}%  ·  {gpu.freq:0} MHz", "font": "JetBrains Mono", "size": 17, "weight": 400, "color": "#8b8aa8", "align": "center" },
    { "id": "gpu-watts", "type": "text", "x": 524, "y": 466, "text": "{gpu.power:0} W", "font": "JetBrains Mono", "size": 18, "weight": 700, "color": "#c77dff", "align": "center" },

    { "id": "ram-label", "type": "text", "x": 72, "y": 580, "text": "RAM", "font": "Inter", "size": 18, "weight": 700, "color": "#8b8aa8", "align": "left", "letter_spacing": 3 },
    { "id": "ram-value", "type": "text", "x": 648, "y": 580, "text": "{mem.used:0} / {mem.total:0} MB", "font": "JetBrains Mono", "size": 16, "weight": 400, "color": "#c9c8dc", "align": "right" },
    { "id": "ram-bar", "type": "bar", "x": 72, "y": 592, "w": 576, "h": 14, "metric": "mem.pct", "min": 0, "max": 100, "color": "#ffc20e", "track": "#1f1d33", "radius": 7 },

    { "id": "vram-label", "type": "text", "x": 72, "y": 648, "text": "VRAM", "font": "Inter", "size": 18, "weight": 700, "color": "#8b8aa8", "align": "left", "letter_spacing": 3 },
    { "id": "vram-value", "type": "text", "x": 648, "y": 648, "text": "{gpu.vram:0} / {gpu.vram_total:0} MB", "font": "JetBrains Mono", "size": 16, "weight": 400, "color": "#c9c8dc", "align": "right" },
    { "id": "vram-bar", "type": "bar", "x": 72, "y": 660, "w": 576, "h": 14, "metric": "gpu.vram_pct", "min": 0, "max": 100, "color": "#9b30ff", "track": "#1f1d33", "radius": 7 }
  ]
}
